{
  "name": "dsh-whale-musume",
  "version": "2.0.1",
  "private": true,
  "description": "A whale-girl Kanban Musume mascot for DeepSeek Harness",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/whale-moe-core.test.mjs test/whale-moe-growth.test.mjs test/apply-theme.test.mjs test/whale-moe-game.test.mjs test/whale-moe-fx.test.mjs test/whale-moe-quest.test.mjs test/whale-moe-zones.test.mjs",
    "qa": "node test/motion-qa.mjs && node test/cdp-whale-moe.mjs",
    "qa:soak": "node test/soak-work.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.4": "unknown",
        "0.1.2-alpha.5": "unknown",
        "0.1.2-rc.1": "compatible"
      }
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mascot",
    "desktop-pet",
    "whale-girl",
    "cute"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sutera-Diffusus/dsh-whale-musume.git"
  },
  "bugs": {
    "url": "https://github.com/Sutera-Diffusus/dsh-whale-musume/issues"
  },
  "homepage": "https://github.com/Sutera-Diffusus/dsh-whale-musume#readme"
}

{
  "name": "dsh-whale-musume",
  "version": "2.2.0",
  "private": true,
  "description": "鲸鱼娘桌面宠物（看板娘 / desktop pet mascot）for DeepSeek Harness：陪你写代码的 whale-girl 桌宠，桌面端与 Web 双端支持",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*test.mjs",
    "qa": "node test/motion-qa.mjs && node test/cdp-whale-moe.mjs",
    "qa:soak": "node test/soak-work.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.4": "unknown",
        "0.1.2-alpha.5": "unknown",
        "0.1.2-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      },
      "note": "0.2.0-rc.2 是 DeepSeek Harness 桌面端（Electron 壳）内嵌的运行时，已在隔离 profile 上完成安装、加载与 DOM 契约验收：桌宠可见、设置面板注册、零控制台错误、零外部请求。迁移说明见 docs/desktop-0.2.0-rc.2-contract.md 与 docs/desktop-0.2.0-rc.2-deploy.md。"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mascot",
    "desktop-pet",
    "whale-girl",
    "cute"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sutera-Diffusus/dsh-whale-musume.git"
  },
  "bugs": {
    "url": "https://github.com/Sutera-Diffusus/dsh-whale-musume/issues"
  },
  "homepage": "https://github.com/Sutera-Diffusus/dsh-whale-musume#readme"
}

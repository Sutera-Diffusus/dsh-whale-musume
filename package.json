{
  "name": "dsh-whale-musume",
  "version": "2.5.0",
  "description": "鲸鱼娘桌面宠物（看板娘 / desktop pet mascot）for DeepSeek Harness：陪你写代码的 whale-girl 桌宠，桌面端与 Web 双端支持",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/generated",
    "assets/dsh-whale-moe.css",
    "assets/dsh-whale-moe.js",
    "assets/whale-moe-core.js",
    "assets/peek-calibration.json",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*test.mjs",
    "prepublishOnly": "node --test test/*test.mjs",
    "publish:npm": "npm publish --access public --registry=https://registry.npmjs.org",
    "qa": "node test/motion-qa.mjs && node test/cdp-whale-moe.mjs",
    "qa:soak": "node test/soak-work.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0-rc.6 <0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.4": "unknown",
        "0.1.2-alpha.5": "unknown",
        "0.1.2-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      },
      "note": "0.2.0-rc.2 已在隔离 profile 上完成安装、加载与 DOM 契约验收。0.2.1-rc.1 / 0.2.1-rc.2 的 compatible 来自对 tag dsh-v0.2.1-rc.2 的静态契约核对加本仓库单元测试，尚未在真实 Electron 桌面端复跑。0.2.1-rc.3 已在两台 Windows 机器的真实 Electron 桌面端完成安装、加载与重启复验（bundle patch 叠加、静态资源路由、dsh.client 注入均通过），见 issue #32。自 DSH 0.2.1-alpha.4 起，安装门禁优先读顶层 engines.dsh（未声明才回落 peerDependencies）；本包没有 DSH peer，因此必须声明 engines.dsh。说明见 docs/desktop-0.2.1-rc.2-contract.md。"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mascot",
    "desktop-pet",
    "whale-girl",
    "cute"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sutera-Diffusus/dsh-whale-musume.git"
  },
  "bugs": {
    "url": "https://github.com/Sutera-Diffusus/dsh-whale-musume/issues"
  },
  "homepage": "https://github.com/Sutera-Diffusus/dsh-whale-musume#readme"
}
